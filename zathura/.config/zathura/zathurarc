# Enable recolor mode and tell Zathura to preserve original colors/hues
set recolor true
set recolor-keephue true

# Set the background to dark/transparent and dark text to light (for contrast)
set recolor-lightcolor rgba(0,0,0,0)
set recolor-darkcolor "#ffffff"

# Layout & Interface
set default-bg rgba(0,0,0,0.75)
set adjust-open "width"
set guioptions "sv"
set first-page-column 1:2
set font "Inter 10"
set selection-clipboard clipboard

# Keybindings
map j feedkeys "<C-Down>"
map k feedkeys "<C-Up>"