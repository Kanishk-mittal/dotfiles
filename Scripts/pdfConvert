#!/usr/bin/env python3
"""
Office to PDF Converter - A utility to convert PowerPoint and Word files to PDF format.
Uses LibreOffice for conversion, with safe handling of files.
"""

import os
import sys
import time
import argparse
import subprocess
from typing import Dict, List, Any, Optional


def convert_to_pdf(input_file: str, output_dir: Optional[str] = None) -> str:
    """
    Convert an Office file (PPTX or DOCX) to PDF using LibreOffice.
    
    Args:
        input_file: Path to the Office file (.pptx or .docx)
        output_dir: Directory to save the PDF (defaults to same directory as input)
        
    Returns:
        Path to the generated PDF file
        
    Raises:
        FileNotFoundError: If input file doesn't exist
        RuntimeError: If conversion fails or PDF not created
    """
    if not os.path.isfile(input_file):
        raise FileNotFoundError(f"No such file: '{input_file}'")
    
    # Use the same directory as the input file if output_dir is not provided
    if output_dir is None:
        output_dir = os.path.dirname(os.path.abspath(input_file))

    # Construct the LibreOffice conversion command
    cmd = [
    "soffice",
    "--headless",
    "--invisible",
    "--nologo",
    "--nodefault",
    "--nofirststartwizard",
    "--convert-to", "pdf",
    "--outdir", output_dir,
    input_file
    ]


    # Run the command and capture output
    process = subprocess.run(cmd, capture_output=True, text=True)
    if process.returncode != 0:
        error_msg = process.stderr or "No error details available"
        raise RuntimeError(f"LibreOffice conversion failed: {error_msg}")

    # Expected PDF path
    base_name = os.path.splitext(os.path.basename(input_file))[0]
    pdf_path = os.path.join(output_dir, f"{base_name}.pdf")

    # Short retry loop for file appearance
    retry_count = 0
    while not os.path.isfile(pdf_path) and retry_count < 3:
        time.sleep(1)
        retry_count += 1

    if not os.path.isfile(pdf_path):
        raise RuntimeError("PDF file was not created despite successful return code")

    return pdf_path


def find_office_files(root_dir: str) -> List[str]:
    """
    Find all PPTX and DOCX files in the specified directory and its subdirectories.
    
    Args:
        root_dir: Directory to search
        
    Returns:
        List of full paths to Office files (.pptx, .docx)
    """
    office_files = []
    extensions = (".pptx", ".docx",".odp")
    for dirpath, _, filenames in os.walk(root_dir):
        for filename in filenames:
            if filename.lower().endswith(extensions):
                office_files.append(os.path.join(dirpath, filename))
    return office_files


def process_file(
    file_path: str,
    output_dir: Optional[str] = None,
    keep_original: bool = False,
) -> Dict[str, Any]:
    """
    Process a single Office file: convert to PDF and optionally delete original.

    Args:
        file_path: Path to the Office file
        output_dir: Optional output directory for generated PDF files
        keep_original: Keep original file after successful conversion

    Returns:
        Dictionary with status information
    """
    try:
        pdf_path = convert_to_pdf(file_path, output_dir=output_dir)
        if not keep_original:
            # Remove original after successful conversion unless keep_original is set.
            os.remove(file_path)
        return {"status": "success", "file": file_path, "pdf_path": pdf_path}
    except Exception as e:
        return {"status": "failed", "file": file_path, "error": str(e)}


def parse_args() -> argparse.Namespace:
    """Parse command-line arguments for the converter."""
    parser = argparse.ArgumentParser(
        description="Convert Office files (.pptx, .docx, .odp) to PDF using LibreOffice.",
    )
    parser.add_argument(
        "directory",
        nargs="?",
        help="Directory to scan recursively for Office files.",
    )
    parser.add_argument(
        "-o",
        "--output-dir",
        help="Optional directory where all PDFs will be written.",
    )
    parser.add_argument(
        "--keep-original",
        action="store_true",
        help="Keep source Office files after successful conversion.",
    )
    return parser.parse_args()


def display_results(results: List[Dict[str, Any]]) -> None:
    """
    Display a summary of conversion results.
    """
    successful = [r["file"] for r in results if r["status"] == "success"]
    failed = [(r["file"], r.get("error")) for r in results if r["status"] != "success"]

    print("\nConversion Summary:")
    print(f"- Successfully converted: {len(successful)} files")

    if successful:
        print("\nSuccessfully converted files:")
        for file in successful:
            print(f"- {os.path.basename(file)}")

    if failed:
        print("\nFailed conversions:")
        for file, error in failed:
            print(f"- {os.path.basename(file)}: {error}")

    print("\nConversion process completed.")


def main() -> int:
    """Main function to run the converter."""
    args = parse_args()

    print("Office to PDF Converter")
    print("=========================")

    dir_path = args.directory or input(
        "Enter the directory to convert .pptx/.docx/.odp files to PDF: "
    )
    if not os.path.isdir(dir_path):
        print(f"Error: '{dir_path}' is not a valid directory.")
        return 1

    if args.output_dir and not os.path.isdir(args.output_dir):
        print(f"Error: output directory '{args.output_dir}' is not a valid directory.")
        return 1

    files = find_office_files(dir_path)
    if not files:
        print("No .pptx, .docx, or .odp files found in the directory or its subdirectories.")
        return 0

    print(f"Found {len(files)} Office files. Starting conversion...")

    results = []
    for i, file in enumerate(files, 1):
        print(f"Processing [{i}/{len(files)}]: {os.path.basename(file)}")
        results.append(
            process_file(
                file,
                output_dir=args.output_dir,
                keep_original=args.keep_original,
            )
        )

    display_results(results)
    return 0


if __name__ == "__main__":
    sys.exit(main())
